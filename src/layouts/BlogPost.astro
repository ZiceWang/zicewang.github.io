---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { renderInlineMath } from '../utils/renderInlineMath';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, source = '' } = Astro.props;
const titleHtml = renderInlineMath(title);
const hasSource = source.length > 0;
const sourceJson = JSON.stringify(source).replaceAll('<', '\\u003c');
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
				padding-top: clamp(2rem, 5vw, 4rem);
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(840px, calc(100% - 2rem));
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em 1em 4rem;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: clamp(2rem, 6vw, 4rem);
				padding: 0 0 1.25rem;
				border-bottom: 1px solid rgba(var(--black), 12%);
				text-align: left;
				line-height: 1;
			}
			.title h1 {
				margin: 0.12em 0 0;
				font-size: clamp(3.4rem, 9vw, 7rem);
				line-height: 0.9;
			}
			.date {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.copy-post {
				display: inline-grid;
				width: 2.15rem;
				height: 2.15rem;
				place-items: center;
				flex: 0 0 auto;
				padding: 0;
				border: 1px solid rgba(var(--black), 12%);
				border-radius: 999px;
				background: var(--surface-soft);
				color: rgb(var(--black));
				cursor: pointer;
				transition:
					color 160ms ease,
					border-color 160ms ease,
					background 160ms ease,
					transform 160ms ease;
			}
			.copy-post:hover,
			.copy-post:focus-visible,
			.copy-post[data-copied='true'] {
				color: var(--accent);
				border-color: rgba(var(--black), 22%);
				background: var(--surface-strong);
				transform: translateY(-1px);
				outline: none;
			}
			.copy-post[data-copied='false'] {
				color: #b74a4a;
				border-color: rgba(214, 91, 91, 0.45);
			}
			.copy-post svg {
				width: 1.08rem;
				height: 1.08rem;
				fill: none;
				stroke: currentColor;
				stroke-linecap: round;
				stroke-linejoin: round;
				stroke-width: 1.8;
			}
			.last-updated-on {
				font-style: italic;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<div>
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							{
								hasSource && (
									<button class="copy-post" type="button" data-copy-post aria-label="Copy full post source">
										<svg viewBox="0 0 24 24" aria-hidden="true">
											<rect x="9" y="9" width="10" height="10" rx="2" />
											<path d="M5 15V7a2 2 0 0 1 2-2h8" />
										</svg>
									</button>
								)
							}
						</div>
						<h1 set:html={titleHtml} />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script id="post-source" type="application/json" set:html={sourceJson} />
		<script>
			const copyLabels = new WeakMap<HTMLButtonElement, number>();
			const postSourceElement = document.getElementById('post-source');
			const postSource = postSourceElement?.textContent ? JSON.parse(postSourceElement.textContent) : '';

			document.querySelector<HTMLButtonElement>('[data-copy-post]')?.addEventListener('click', async (event) => {
				const button = event.currentTarget;
				if (!(button instanceof HTMLButtonElement)) return;

				window.clearTimeout(copyLabels.get(button));

				try {
					await navigator.clipboard.writeText(postSource);
					button.dataset.copied = 'true';
					button.setAttribute('aria-label', 'Copied full post source');
				} catch {
					button.dataset.copied = 'false';
					button.setAttribute('aria-label', 'Failed to copy full post source');
				}

				const timeout = window.setTimeout(() => {
					delete button.dataset.copied;
					button.setAttribute('aria-label', 'Copy full post source');
				}, 1400);
				copyLabels.set(button, timeout);
			});

			function getFormulaSource(element: Element) {
				const annotation = element.querySelector('annotation[encoding="application/x-tex"]');
				return annotation?.textContent?.trim() ?? '';
			}

			function formulaText(element: Element) {
				const source = getFormulaSource(element);
				if (!source) return element.textContent ?? '';

				const isDisplay = Boolean(element.closest('.katex-display'));
				return isDisplay ? `$$\n${source}\n$$` : `$${source}$`;
			}

			function selectionContainsFormula(selection: Selection) {
				if (selection.rangeCount === 0) return false;

				for (let index = 0; index < selection.rangeCount; index += 1) {
					const range = selection.getRangeAt(index);
					const container =
						range.commonAncestorContainer.nodeType === Node.ELEMENT_NODE
							? range.commonAncestorContainer
							: range.commonAncestorContainer.parentElement;

					if (container instanceof Element && container.closest('.katex')) return true;
					if (container instanceof Element && container.querySelector('.katex')) return true;
				}

				return false;
			}

			function textWithLatex(node: Node) {
				if (node.nodeType === Node.TEXT_NODE) return node.textContent ?? '';
				if (!(node instanceof Element)) return '';
				if (node.classList.contains('katex')) return formulaText(node);
				if (node.matches('annotation[encoding="application/x-tex"]')) return '';
				if (node.matches('.katex-mathml, .katex-html')) return '';
				if (node.matches('br')) return '\n';

				const text = Array.from(node.childNodes, textWithLatex).join('');

				if (node.matches('p, div, blockquote, li, tr, h1, h2, h3, h4, h5, h6')) {
					return `${text}\n`;
				}

				return text;
			}

			document.querySelectorAll<HTMLElement>('.prose .katex').forEach((formula) => {
				const source = getFormulaSource(formula);
				if (!source) return;

				formula.dataset.latex = source;
				formula.setAttribute('aria-label', source);
			});

			document.addEventListener('copy', (event) => {
				const selection = window.getSelection();
				if (!selection || selection.isCollapsed || !selectionContainsFormula(selection)) return;

				const text = Array.from({ length: selection.rangeCount }, (_, index) => {
					const fragment = selection.getRangeAt(index).cloneContents();
					return Array.from(fragment.childNodes, textWithLatex).join('');
				})
					.join('\n')
					.replace(/\n{3,}/g, '\n\n')
					.trim();

				if (!text) return;

				event.preventDefault();
				event.clipboardData?.setData('text/plain', text);
			});

			document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((block) => {
				const code = block.querySelector('code');
				if (!code || block.querySelector('.copy-code')) return;

				const wrapper = document.createElement('div');
				wrapper.className = 'code-frame';
				wrapper.dataset.language = block.dataset.language || 'code';
				block.before(wrapper);
				wrapper.append(block);

				const button = document.createElement('button');
				button.className = 'copy-code';
				button.type = 'button';
				button.setAttribute('aria-label', 'Copy code block');
				button.innerHTML = `
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<rect x="9" y="9" width="10" height="10" rx="2"></rect>
						<path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
					</svg>
				`;

				button.addEventListener('click', async () => {
					window.clearTimeout(copyLabels.get(button));

					try {
						await navigator.clipboard.writeText(code.textContent ?? '');
						button.dataset.copied = 'true';
						button.setAttribute('aria-label', 'Copied code block');
					} catch {
						button.dataset.copied = 'false';
						button.setAttribute('aria-label', 'Failed to copy code block');
					}

					const timeout = window.setTimeout(() => {
						delete button.dataset.copied;
						button.setAttribute('aria-label', 'Copy code block');
					}, 1400);
					copyLabels.set(button, timeout);
				});

				wrapper.append(button);
			});
		</script>
	</body>
</html>
