---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { renderInlineMath } from '../../utils/renderInlineMath';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1120px, calc(100% - 2rem));
				padding-top: clamp(3rem, 7vw, 6rem);
			}
			.archive-head {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.36fr);
				gap: 2rem;
				align-items: end;
				margin-bottom: clamp(2rem, 6vw, 4rem);
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgba(var(--black), 12%);
			}
			.kicker {
				margin: 0 0 0.8rem;
				color: rgb(var(--gray));
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}
			h1 {
				margin: 0;
				font-size: clamp(4rem, 11vw, 9rem);
				line-height: 0.86;
			}
			.archive-note {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1rem;
				line-height: 1.6;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1px;
				list-style-type: none;
				margin: 0;
				padding: 0;
				border: 1px solid rgba(var(--black), 10%);
				background: rgba(var(--black), 10%);
			}
			ul li {
				min-height: 15rem;
				background: var(--surface);
			}
			ul li * {
				text-decoration: none;
				transition:
					color 160ms ease,
					transform 180ms ease,
					opacity 180ms ease;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 0;
			}
			ul li a {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				height: 100%;
				padding: clamp(1.25rem, 3vw, 2rem);
				color: rgb(var(--black));
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				font-size: clamp(2.4rem, 5vw, 5rem);
				line-height: 0.9;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.82rem;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}
			.description {
				max-width: 28rem;
				margin: 1rem 0 0;
				color: rgb(var(--gray));
				font-size: 1rem;
				line-height: 1.45;
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--accent);
			}
			ul li a:hover .description {
				color: rgb(var(--gray-dark));
				transform: translateX(0.35rem);
			}
			.empty {
				padding: 2rem;
				border: 1px solid rgba(var(--black), 10%);
				background: var(--surface);
				color: rgb(var(--gray));
			}
			@media (max-width: 720px) {
				.archive-head {
					grid-template-columns: 1fr;
				}
				ul {
					grid-template-columns: 1fr;
				}
				ul li {
					min-height: 12rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<header class="archive-head">
				<div>
					<p class="kicker">Archive</p>
					<h1>Blog</h1>
				</div>
				<p class="archive-note">A running index of notes, builds, and technical traces.</p>
			</header>
			<section>
				{
					posts.length > 0 ? (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										{post.data.heroImage && (
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<div>
										<h4 class="title" set:html={renderInlineMath(post.data.title)} />
										<p class="description">{post.data.description}</p>
									</div>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))}
						</ul>
					) : (
						<p class="empty">No posts yet.</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
