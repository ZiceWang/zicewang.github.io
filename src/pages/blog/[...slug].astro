---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import BlogPost from '../../layouts/BlogPost.astro';

async function getPostSource(id: string) {
	const candidates = [
		join(process.cwd(), 'src', 'content', 'blog', `${id}.mdx`),
		join(process.cwd(), 'src', 'content', 'blog', `${id}.md`),
	];

	for (const candidate of candidates) {
		try {
			return await readFile(candidate, 'utf-8');
		} catch {
			// Try the next supported content extension.
		}
	}

	return '';
}

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);
const source = await getPostSource(post.id);
---

<BlogPost {...post.data} source={source}>
	<Content />
</BlogPost>
