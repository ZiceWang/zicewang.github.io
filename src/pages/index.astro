---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import LandingDial from '../components/LandingDial.svelte';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { renderInlineMath } from '../utils/renderInlineMath';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const navItems = [
	{ label: 'Blog', subtitle: 'Notes, builds, and technical traces', href: '/blog/', mode: 'posts' },
	{ label: 'About', subtitle: 'Who I am and what this site is for', href: '/about/' },
	{
		label: 'GitHub',
		subtitle: 'Code, experiments, and public work',
		href: 'https://github.com/ZiceWang',
		external: true,
	},
];

const postItems = posts.map((post) => ({
	label: post.data.title,
	labelHtml: renderInlineMath(post.data.title),
	meta: post.data.pubDate.toLocaleDateString('en', {
		month: 'short',
		day: 'numeric',
		year: 'numeric',
	}),
	subtitle: post.data.description,
	href: `/blog/${post.id}/`,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<LandingDial navItems={navItems} postItems={postItems} client:load />
	</body>
</html>
